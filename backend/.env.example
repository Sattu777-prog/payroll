# ── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (SPA host)
CLIENT_URL=http://localhost:5173

# ── Database (SQLite, zero-config) ──────────────────────────────
# The app uses Node's built-in node:sqlite — no server required.
# The database file lives at backend/data/nexus.db (auto-created).
# Optionally override the file location:
# DB_PATH=./data/nexus.db

# ── Auth / JWT ──────────────────────────────────────────────────
# REQUIRED in production — generate with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ── Seeding (npm run db:seed) ───────────────────────────────────
# Password applied to the three demo accounts. Change in production!
SEED_PASSWORD=Password123!